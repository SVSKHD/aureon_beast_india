# Aureon MCX - environment configuration (copy to .env; never commit .env)
BROKER=dhan

# Dhan credentials: environment only. Never printed, never committed.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

SYMBOLS=GOLD,SILVER
EXCHANGE_SEGMENT=MCX_COMM
PRIMARY_TIMEFRAME=M5

EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
ATR_PERIOD=14

SWING_STRENGTH=2

MTF=M5,M15,H1,H4

AUREON_STORAGE_BACKEND=sqlite
AUREON_LOCAL_DB_PATH=data/aureon_mcx.db
AUREON_CONFIG_DIR=config
AUREON_PARQUET_ARCHIVE=false
AUREON_PARQUET_DIR=data/parquet
AUREON_LOG_LEVEL=INFO

DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=        # optional
